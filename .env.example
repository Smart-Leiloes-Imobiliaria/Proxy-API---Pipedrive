PIPEDRIVE_API_TOKEN=coloque_o_token_real_do_pipedrive
PIPEDRIVE_PROXY_API_TOKEN=coloque_o_token_publico_da_proxy
PIPEDRIVE_COMPANY_DOMAIN=smartleiloes

# O browser recebe no-store; este TTL vale para cache de CDN da Vercel.
PIPEDRIVE_PROXY_CDN_CACHE_TTL_SECONDS=30

# Cache em memoria por instancia serverless.
PIPEDRIVE_PROXY_UPSTREAM_CACHE_TTL_SECONDS=60
PIPEDRIVE_PROXY_DETAIL_CACHE_TTL_SECONDS=60
PIPEDRIVE_PROXY_METADATA_CACHE_TTL_SECONDS=21600

# Ajuste fino de performance.
PIPEDRIVE_PROXY_CONCURRENCY=8
PIPEDRIVE_PROXY_FETCH_TIMEOUT_MS=25000
PIPEDRIVE_PROXY_FETCH_RETRIES=3
