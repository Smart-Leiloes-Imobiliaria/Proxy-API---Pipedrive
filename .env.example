PIPEDRIVE_API_TOKEN=coloque_o_token_real_do_pipedrive
# Aceita múltiplos tokens separados por vírgula — todos têm acesso completo
PIPEDRIVE_PROXY_API_TOKEN=token_principal,token_extra_1,token_extra_2
PIPEDRIVE_COMPANY_DOMAIN=smartleiloes

# O browser recebe no-store; este TTL vale para cache de CDN da Vercel.
PIPEDRIVE_PROXY_CDN_CACHE_TTL_SECONDS=30

# Cache em memoria por instancia serverless.
PIPEDRIVE_PROXY_UPSTREAM_CACHE_TTL_SECONDS=60
PIPEDRIVE_PROXY_DETAIL_CACHE_TTL_SECONDS=60
PIPEDRIVE_PROXY_METADATA_CACHE_TTL_SECONDS=21600

# Ajuste fino de performance.
PIPEDRIVE_PROXY_CONCURRENCY=8
PIPEDRIVE_PROXY_FETCH_TIMEOUT_MS=25000
PIPEDRIVE_PROXY_FETCH_RETRIES=3

# --- Rota /api/chatapp/verificar-triagem ---
# Token interno que o ChatApp envia (query ?token= ou header Authorization/X-Internal-Token).
CHATAPP_INTERNAL_TOKEN=defina_uma_chave_forte_para_o_chatapp

# IDs (separados por virgula) que definem cada esteira. pipeline_id OU stage_id bastam.
PIPELINES_ANALISE_CREDITO=
STAGES_ANALISE_CREDITO=
PIPELINES_POS_ARREMATACAO=
STAGES_POS_ARREMATACAO=

# Status do deal aceitos por esteira (lista por virgula). Default "open" se vazio.
# Ex.: para tambem considerar ganhos -> open,won
ALLOWED_STATUSES_ANALISE_CREDITO=open
ALLOWED_STATUSES_POS_ARREMATACAO=open

# --- Rota /api/chatapp/verificar-triagem-funis ---
# Status que contam para a regra "Triagem Necessaria" do endpoint de funis.
# Se vazio, usa os ALLOWED_STATUSES_* acima e, na ausencia deles, "open".
ALLOWED_STATUSES_CHATAPP_FUNIS=open

# --- Rota NOVA /api/chatapp/rotear-funil (roteamento persistente por funil) ---
# Reusa CHATAPP_INTERNAL_TOKEN acima (mesmo mecanismo de auth). Somente deals
# com status "open" sao considerados; nao ha env para configurar isso (regra
# fixa da tarefa, ao contrario das rotas antigas acima).
#
# IDs de pipeline e da opcao "Financiado / FGTS Financiado" sao FIXOS como
# constantes em lib/chatapp-rotear-funil.js (confirmados no XLS de campos de
# 06/08/2026), nao dependem de env:
#   PIPELINE_ANALISE_CREDITO_ID  = 16
#   PIPELINE_POS_ARREMATACAO_ID  = 6
#   PAYMENT_OPTION_FINANCED      = 34 (Financiado / FGTS Financiado)

# --- Rota POST /api/chatapp/avaliar-atendimento ---
# Reutiliza CHATAPP_INTERNAL_TOKEN para autenticar o HELPER | GPT.
# Nunca versione os valores reais, tokens capturados nem arquivos JSON de Service Account.
CHATAPP_API_BASE_URL=https://api.chatapp.example
CHATAPP_COMPANY_ID=defina_o_company_id_da_chatapp
CHATAPP_EMAIL=email_da_conta_chatapp
CHATAPP_PASSWORD=senha_da_conta_chatapp
CHATAPP_APP_ID=id_do_app_chatapp
CHATAPP_ACCESS_TOKEN=access_token_inicial_opcional
CHATAPP_ACCESS_TOKEN_END_TIME=0
CHATAPP_REFRESH_TOKEN=refresh_token_inicial_opcional
CHATAPP_REFRESH_TOKEN_END_TIME=0
# O ChatApp envia datetime em fuso deslocado neste fluxo; por padrao somamos 3h
# antes de filtrar/salvar a janela de avaliacao. Use 0 se o Scenario passar ISO UTC correto.
CHATAPP_EVALUATION_TIME_OFFSET_HOURS=3
OPENAI_API_KEY=defina_a_chave_da_openai
OPENAI_MODEL=defina_o_model_compativel_com_structured_outputs
# Caminho relativo ao projeto. Em producao Vercel, o arquivo segue junto no deploy.
EVALUATION_PROMPT_FILE=prompts/chatapp-evaluation.txt
# Fallback legado se quiser manter o prompt em env em vez de arquivo.
# EVALUATION_PROMPT=forneca_o_prompt_de_negocio_de_avaliacao
GOOGLE_SHEETS_SPREADSHEET_ID=defina_o_id_da_planilha
GOOGLE_SHEETS_SHEET_NAME=defina_o_nome_da_aba
GOOGLE_SERVICE_ACCOUNT_EMAIL=conta-de-servico@projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n[REDACTED]\\n-----END PRIVATE KEY-----\\n"
